# Copy to .env.local. Values below must come from your NEW Firebase Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: official WhatsApp, digits including country and area code.
VITE_SUPPORT_WHATSAPP=
# Only for local development with Firebase emulators. Never enable in production.
VITE_USE_EMULATORS=false
