{
  "name": "profind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1 --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:rules": "firebase emulators:exec --project demo-profind --only firestore \"node --test tests/rules/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:integration": "firebase emulators:exec --project demo-profind --only auth,firestore \"playwright test --config playwright.integration.config.ts\"",
    "emulators": "firebase emulators:start --project demo-profind --only auth,firestore",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "@opentelemetry/core": "^2.8.0",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
